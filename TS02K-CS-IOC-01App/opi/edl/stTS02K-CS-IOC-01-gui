#!/bin/sh
TOP="$(cd $(dirname "$0")/../..; pwd)"

# first load the paths. These have been generated from the configure/RELEASE
# tree. If we have a -d arg then load the opi/edl paths first
shopt -s nullglob
unset EDMDATAFILES
if [ "$1" = "-d" ]; then
    for d in ${TOP}/*App/opi/edl; do
        EDMDATAFILES="${EDMDATAFILES}${d}:"
    done
    EDMDATAFILES="${EDMDATAFILES}${TOP}/data:"
    EDMDATAFILES="${EDMDATAFILES}/dls_sw/prod/R3.14.12.7/support/dlsPLC/3-0-68/dlsPLCApp/opi/edl:"
    EDMDATAFILES="${EDMDATAFILES}/dls_sw/prod/R3.14.12.7/support/ether_ip/3-1dls1-4/ether_ipApp/opi/edl:"
    EDMDATAFILES="${EDMDATAFILES}/dls_sw/prod/R3.14.12.7/support/idPLC/0-8/idPLCApp/opi/edl:"

    OPTS="-x -eolc"
else
    OPTS="-x -eolc -noedit"
fi
EDMDATAFILES="${EDMDATAFILES}${TOP}/data"
EDMDATAFILES="${EDMDATAFILES}:/dls_sw/prod/R3.14.12.7/support/devIocStats/3-1-14dls3-2/data"
EDMDATAFILES="${EDMDATAFILES}:/dls_sw/prod/R3.14.12.7/support/dlsPLC/3-0-68/data"
EDMDATAFILES="${EDMDATAFILES}:/dls_sw/prod/R3.14.12.7/support/ether_ip/3-1dls1-4/data"
EDMDATAFILES="${EDMDATAFILES}:/dls_sw/prod/R3.14.12.7/support/idPLC/0-8/data"
EDMDATAFILES="${EDMDATAFILES}:/dls_sw/prod/R3.14.12.7/support/pvlogging/1-4/data"

export EDMDATAFILES

# Set the path to include any scripts in data dirs
export PATH=${EDMDATAFILES}:${PATH}
edm ${OPTS}  TS02K-CS-IOC-01Top.edl